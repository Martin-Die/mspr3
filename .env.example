# Dossier data/ : tous les fichiers .xls / .xlsx / .tsv / .csv sont lus automatiquement
ECO2MIX_DATA_PATHS=data

# Snowflake (tache write_forecasts_to_snowflake)
SNOWFLAKE_ACCOUNT=votre_compte
SNOWFLAKE_USER=votre_utilisateur
SNOWFLAKE_PASSWORD=votre_mot_de_passe
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=EDF_ML
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_TABLE=EDF_CONSUMPTION_FORECASTS
SNOWFLAKE_SKIP_WRITE=1

# Airflow
AIRFLOW_SCHEDULE=0 2 * * 1
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
